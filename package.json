{
  "name": "pgelephant-website",
  "version": "1.0.0",
  "description": "PostgreSQL High Availability Made Easy - Official Website",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx",
    "analyze": "ANALYZE=true npm run build",
    "export": "next export",
    "sitemap": "next-sitemap",
    "seo:audit": "npm run build && npm run lighthouse",
    "lighthouse": "lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html --view"
  },
  "dependencies": {
    "@vercel/analytics": "^1.3.7",
    "@vercel/speed-insights": "^1.1.2",
    "framer-motion": "^12.0.6",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.461.0",
    "next": "^15.4.5",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/bundle-analyzer": "^15.4.5",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.2.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.4.5",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
