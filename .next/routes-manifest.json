{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/home",
      "destination": "/",
      "statusCode": 308,
      "regex": "^(?!/_next)/home(?:/)?$"
    },
    {
      "source": "/documentation",
      "destination": "/docs",
      "statusCode": 308,
      "regex": "^(?!/_next)/documentation(?:/)?$"
    },
    {
      "source": "/guide",
      "destination": "/docs",
      "statusCode": 308,
      "regex": "^(?!/_next)/guide(?:/)?$"
    },
    {
      "source": "/tutorial",
      "destination": "/docs",
      "statusCode": 308,
      "regex": "^(?!/_next)/tutorial(?:/)?$"
    },
    {
      "source": "/postgresql-ha",
      "destination": "/ram",
      "statusCode": 308,
      "regex": "^(?!/_next)/postgresql-ha(?:/)?$"
    },
    {
      "source": "/raft-extension",
      "destination": "/pgraft",
      "statusCode": 308,
      "regex": "^(?!/_next)/raft-extension(?:/)?$"
    },
    {
      "source": "/postgresql-raft",
      "destination": "/pgraft",
      "statusCode": 308,
      "regex": "^(?!/_next)/postgresql-raft(?:/)?$"
    },
    {
      "source": "/mongodb-alternative",
      "destination": "/fauxdb",
      "statusCode": 308,
      "regex": "^(?!/_next)/mongodb-alternative(?:/)?$"
    },
    {
      "source": "/consensus",
      "destination": "/rale",
      "statusCode": 308,
      "regex": "^(?!/_next)/consensus(?:/)?$"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "origin-when-cross-origin"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "upgrade-insecure-requests"
        }
      ],
      "regex": "^(?:/(.*))(?:/)?$"
    }
  ],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/blog",
      "regex": "^/blog(?:/)?$",
